{
  "name": "bot-music-discord",
  "version": "1.0.0",
  "description": "Bot de música para Discord usando Kazagumo, Shoukaku y Lavalink",
  "main": "index.js",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "deploy": "node deploy-commands.js",
    "setup": "node setup.js",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "keywords": [
    "discord",
    "bot",
    "music",
    "kazagumo",
    "shoukaku",
    "lavalink"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "kazagumo": "^3.4.3",
    "shoukaku": "^4.3.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
